{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "regions": [
    "sin1"
  ],
  "headers": [
    {
      "source": "/studio/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/orders/reconcile",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/publish-scheduled",
      "schedule": "0 2 * * *"
    }
  ]
}
