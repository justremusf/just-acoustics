[Unit]
Description=Just Acoustics order payment reconciliation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
EnvironmentFile=/etc/just-acoustics-orders.env
ExecStart=/usr/bin/python3 /opt/just-acoustics-orders/poll-orders.py
TimeoutStartSec=300
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
